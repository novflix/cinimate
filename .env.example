# TMDB API read access token (v4)
# Create one at https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=

# Firebase web app config (Project settings → Your apps → Web app → SDK setup and configuration).
# These values are not secrets; copy them from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
